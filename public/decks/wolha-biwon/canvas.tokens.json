{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Wolha Biwon — Plum Bamboo Asymmetry",
  "version": "1.1.0",
  "note": "1.1.0에서 고품질 카투슈 프레임의 실제 well/veil 위치에 맞춰 재보정. 텍스트는 안의 anchor 박스(safeZones.number, safeZones.titleContent)에 중앙 정렬한다. baselineY는 참고값.",
  "canvas": {
    "width": 1200,
    "height": 2040,
    "aspectRatio": 0.5882352941,
    "cornerRadius": 12,
    "scaleBase": 1200
  },
  "safeZones": {
    "sideFrame": 72,
    "number": { "x": 435, "y": 22, "width": 330, "height": 70 },
    "titlePlaque": { "x": 250, "y": 1760, "width": 700, "height": 270 },
    "titleContent": { "x": 300, "y": 1845, "width": 600, "height": 130 }
  },
  "number": {
    "visibleFor": "major-only",
    "anchorX": 600,
    "baselineY": 71,
    "maxWidth": 280,
    "fontFamily": "Noto Serif KR, AppleMyungjo, Times New Roman, serif",
    "fontSize": 38,
    "fontWeight": 700,
    "letterSpacing": 6,
    "lineHeight": 44,
    "color": "#E5C678",
    "outlineColor": "#26222A",
    "outlineWidth": 2.2
  },
  "titleKo": {
    "anchorX": 600,
    "baselineY": 1905,
    "maxWidth": 560,
    "fontFamily": "Noto Serif KR, AppleMyungjo, serif",
    "fontWeight": 600,
    "fontSize": 50,
    "fontSizeMedium": 44,
    "fontSizeLong": 38,
    "mediumThreshold": 9,
    "longThreshold": 13,
    "letterSpacing": 6,
    "color": "#F5EFE7"
  },
  "titleEn": {
    "anchorX": 600,
    "baselineY": 1948,
    "maxWidth": 620,
    "fontFamily": "Wanted Sans, Avenir Next, Arial, sans-serif",
    "fontWeight": 400,
    "fontSize": 16,
    "fontSizeMedium": 14,
    "fontSizeLong": 12,
    "mediumThreshold": 22,
    "longThreshold": 30,
    "letterSpacing": 3.4,
    "color": "#C9C1B8",
    "gap": 8
  },
  "shadow": {
    "blur": 2.4,
    "offsetY": 2,
    "opacity": 0.78,
    "color": "#090A0D"
  },
  "responsive": {
    "positionMode": "fixed-proportional",
    "scaleFormula": "renderWidth / 1200",
    "minimumRenderWidth": 300,
    "minorArcanaKeepsEmptyTopPlaque": true
  }
}
