# Supabase (P1). 값은 .env.local 에만 넣고 커밋하지 말 것.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 상용화 전 배포 검증에서만 true. 공개 출시 전 삭제하거나 false로 설정.
NEXT_PUBLIC_ENABLE_RELEASE_TEST_TOOLS=false

# GA4 측정 ID("G-"로 시작). 퍼널 이벤트(reading_start … deck_modal_opened)를
# 보낼 대상이다. 비어 있거나 형식이 아니면 GA 스크립트를 로드하지 않고
# 이벤트도 한 건도 나가지 않는다.
NEXT_PUBLIC_GA_ID=

# AdSense 게시자 ID("ca-pub-"로 시작). 비어 있으면 광고 스크립트도
# google-adsense-account 메타 태그도 렌더하지 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 출시 기념 한정 프로모션. 정확히 "true"일 때만 켜진다.
# 켜면 로그인하신 분께 프리미엄 덱을 전부 열어 드리고, 게스트에게는 컬렉션
# 화면 맨 위에 로그인 유인 문구가 나온다. 게스트에게 덱이 열리지는 않는다
# (collection-access.ts가 로그인 여부를 먼저 본다).
# 유료 판매를 시작하는 순간 반드시 끌 것 — 켜진 채로 팔면 "무료였는데 유료가
# 됐다"는 소비자 오인이 된다.
NEXT_PUBLIC_LAUNCH_PROMO_DECKS=

# Search Console "HTML 태그" 방식의 확인 코드. <meta> 태그 전체가 아니라
# content="..." 안의 값만 넣는다. 비어 있으면 태그를 내보내지 않는다.
# GA 연동 확인은 이 앱에서 통하지 않는다 — 서버 HTML에 gtag 스니펫이 없다.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
